 {
  "type": "section",
  "data": {
   "num": 5,
   "title": "5.3",
   "subtitle": "OpenStax §2.3, mashqlar 83–130 — savollar va to'liq yechimlar"
  },
  "narr": [
   "Bu bo'limda chekimalar qonunlarini, to'g'ri almashtirish usullarini va noaniqlik holatlarini ko'rib chiqamiz.",
   "Keling, birinchi mashqlar bilan boshlaymiz."
  ],
  "narr_item": [
   -1,
   -1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 83 — Chekimalar qonunlaridan foydalanish",
   "problem": "lim x→0(4x² −2x + 3)",
   "steps": [
    {
     "text": "Almashtirish usulini qo'llaymiz: x o'rniga 0 ni qo'yamiz."
    },
    {
     "text": "4(0)² −2(0) + 3 = 3"
    }
   ],
   "result": "Javob: 3"
  },
  "narr": [
   "Bu birinchi misolda biz oddiy almashtirish usulini qo'llaymiz.",
   "X ning 0 ga intilishini ko'ramiz, shuning uchun x o'rniga 0 ni qo'yamiz.",
   "Natija 3 ga teng ekan."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 84 — Chekimalar qonunlaridan foydalanish",
   "problem": "lim x→1 (x³+3x²+5)/(4−7x)",
   "steps": [
    {
     "text": "Maxraj x=1 da 1-7=-3 ga teng, nolga teng emas."
    },
    {
     "text": "Bo'linma qonuni va almashtirishni qo'llaymiz."
    },
    {
     "text": "(1³+3·1²+5)/(4−7·1) = 9/(-3) = -3"
    }
   ],
   "result": "Javob: -3"
  },
  "narr": [
   "Bu misolda bo'linma qonunini qo'llaymiz.",
   "Avval maxrajni tekshiramiz, u nolga teng emas.",
   "Keyin numerator va maxrajni almashtiramiz.",
   "Natija -3 ga teng."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 85 — Chekimalar qonunlaridan foydalanish",
   "problem": "lim x→−2 √(x²−6x+3)",
   "steps": [
    {
     "text": "Ildiz ostidagi ifoda x=-2 da uzluksiz va musbat."
    },
    {
     "text": "Ildiz qonunini qo'llaymiz."
    },
    {
     "text": "√((-2)²−6(-2)+3) = √(4+12+3) = √19"
    }
   ],
   "result": "Javob: √19"
  },
  "narr": [
   "Bu misolda ildiz qonunini qo'llaymiz.",
   "Ildiz ostidagi ifodaning x=-2 da musbat ekanligini tekshiramiz.",
   "Keyin almashtirishni amalga oshiramiz.",
   "Natija √19 ga teng."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 86 — Chekimalar qonunlaridan foydalanish",
   "problem": "lim x→−1(9x + 1)²",
   "steps": [
    {
     "text": "Daraja qonunini qo'llaymiz, keyin almashtiramiz."
    },
    {
     "text": "(9(-1) + 1)² = (-8)² = 64"
    }
   ],
   "result": "Javob: 64"
  },
  "narr": [
   "Bu misolda daraja qonunini qo'llaymiz.",
   "X ning -1 ga intilishini ko'ramiz.",
   "Natija 64 ga teng."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "section",
