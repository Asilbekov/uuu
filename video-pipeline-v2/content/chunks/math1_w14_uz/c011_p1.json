 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 87 — To'g'ri almashtirish",
   "problem": "lim x→7 x²",
   "steps": [
    {
     "text": "Oddiy almashtirish: 7² = 49"
    }
   ],
   "result": "Javob: 49"
  },
  "narr": [
   "Bu misolda oddiy almashtirishni ko'ramiz.",
   "X ning 7 ga intilishida, natija 49 ga teng."
  ],
  "narr_item": [
   -1,
   0
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 88 — To'g'ri almashtirish",
   "problem": "lim x→−2(4x² −1)",
   "steps": [
    {
     "text": "Almashtirish: 4(-2)² -1 = 4·4 -1 = 15"
    }
   ],
   "result": "Javob: 15"
  },
  "narr": [
   "Bu misolda ham almashtirishni qo'llaymiz.",
   "X ning -2 ga intilishida, natija 15 ga teng."
  ],
  "narr_item": [
   -1,
   0
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 89 — To'g'ri almashtirish",
   "problem": "lim x→0 1/(1+sinx)",
   "steps": [
    {
     "text": "Maxraj x=0 da 1+sin0=1 ≠ 0"
    },
    {
     "text": "Bo'linma qonuni va almashtirish: 1/1 = 1"
    }
   ],
   "result": "Javob: 1"
  },
  "narr": [
   "Bu misolda maxrajni tekshiramiz.",
   "U nolga teng emas, shuning uchun bo'linma qonunini qo'llaymiz.",
   "Natija 1 ga teng."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 90 — To'g'ri almashtirish",
   "problem": "lim x→2 e^(2x−x²)",
   "steps": [
    {
     "text": "Ko'rsatkichni hisoblaymiz: 2(2) - 2² = 0"
    },
    {
     "text": "e^0 = 1"
    }
   ],
   "result": "Javob: 1"
  },
  "narr": [
   "Bu misolda eksponent funksiyani ko'rib chiqamiz.",
   "Ko'rsatkichni hisoblaymiz, u 0 ga teng.",
   "e^0 = 1 ekanligini bilamiz."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 91 — To'g'ri almashtirish",
   "problem": "lim x→1 (2+7x)/(x+6)",
   "steps": [
    {
     "text": "Almashtirish: (2+7·1)/(1+6) = 9/7"
    }
   ],
   "result": "Javob: 9/7"
  },
  "narr": [
   "Bu misolda oddiy kasrni ko'rib chiqamiz.",
   "X ning 1 ga intilishida, natija 9/7 ga teng."
  ],
  "narr_item": [
   -1,
   0
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 92 — To'g'ri almashtirish",
   "problem": "lim x→3 ln(e^(3x))",
   "steps": [
    {
     "text": "Logarifm va eksponenta o'zaro teskari funksiyalar."
    },
    {
     "text": "ln(e^(3x)) = 3x"
    },
    {
     "text": "Limit: 3·3 = 9"
    }
   ],
   "result": "Javob: 9"
  },
  "narr": [
   "Bu misolda logarifm va eksponenta funksiyalarining xossasidan foydalanamiz.",
   "Ular o'zaro teskari funksiyalar ekanligini bilamiz.",
   "Shuning uchun ln(e^(3x)) = 3x bo'ladi.",
   "X ning 3 ga intilishida, natija 9 ga teng."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 },
 {
  "type": "section",
  "data": {
   "num": 5.3,
   "title": "5.3.3",
   "subtitle": "Noaniqlik 0/0 (93–102)"
  },
  "narr": [
   "Endi noaniqlik holatlarini, ayniqsa 0/0 shaklidagi cheksizliklarni ko'rib chiqamiz."
  ],
  "narr_item": [
   -1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 93 — Noaniqlik 0/0",
   "problem": "lim x→4 (x²−16)/(x−4)",
   "steps": [
    {
     "text": "0/0 shakli. Ifodani ajratamiz."
    },
    {
     "text": "x²−16 = (x−4)(x+4)"
    },
    {
     "text": "(x−4)(x+4)/(x−4) = x+4 (x≠4 da)"
    },
    {
     "text": "Limit: 4+4 = 8"
    }
   ],
   "result": "Javob: 8"
  },
  "narr": [
   "Bu misolda 0/0 noaniqlik holati yuzaga keladi.",
   "Ifodani ajratib, umumiy ko'paytuvchini qisqartiramiz.",
   "X+4 ifodasi x=4 da 8 ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 94 — Noaniqlik 0/0",
   "problem": "lim x→2 (x−2)/(x²−2x)",
   "steps": [
    {
     "text": "Maxrajni ajratamiz: x²−2x = x(x−2)"
    },
    {
     "text": "(x−2)/[x(x−2)] = 1/x (x≠2 da)"
    },
    {
     "text": "Limit: 1/2"
    }
   ],
   "result": "Javob: 1/2"
  },
  "narr": [
   "Bu misolda ham 0/0 noaniqlik holati bor.",
   "Maxrajni ajratib, umumiy ko'paytuvchini qisqartiramiz.",
   "1/x ifodasi x=2 da 1/2 ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 95 — Noaniqlik 0/0",
   "problem": "lim x→6 (3x−18)/(2x−12)",
   "steps": [
    {
     "text": "Numerator va maxrajni ajratamiz."
    },
    {
     "text": "3x−18 = 3(x−6)"
    },
    {
     "text": "2x−12 = 2(x−6)"
    },
    {
     "text": "3(x−6)/[2(x−6)] = 3/2 (x≠6 da)"
    },
    {
     "text": "Limit: 3/2"
    }
   ],
   "result": "Javob: 3/2"
  },
  "narr": [
   "Bu misolda ham 0/0 noaniqlik holati bor.",
   "Numerator va maxrajni umumiy ko'paytuvchiga ajratamiz.",
   "Umumiy ko'paytuvchini qisqartiramiz.",
   "3/2 ifodasi x=6 da o'zgarmas bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 96 — Noaniqlik 0/0",
   "problem": "lim h→0 ((1 + h)² −1)/h",
   "steps": [
    {
     "text": "Numeratorni ochamiz: 1+2h+h²−1 = 2h+h²"
    },
    {
     "text": "(2h+h²)/h = 2+h (h≠0 da)"
    },
    {
     "text": "Limit: 2 (x² ning hosilasi x=1 da)"
    }
   ],
   "result": "Javob: 2"
  },
  "narr": [
   "Bu misolda hosilaning ta'rifidan foydalanamiz.",
   "Numeratorni ochib, h ga bo'lamiz.",
   "H ning 0 ga intilishida, natija 2 ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 97 — Noaniqlik 0/0",
   "problem": "lim x→9 (x−9)/(√x−3)",
   "steps": [
    {
     "text": "0/0 shakli. Maxrajning konjugatiga ko'paytiramiz."
    },
    {
     "text": "(x−9)/(√x−3) · (√x+3)/(√x+3)"
    },
    {
     "text": "(x−9)(√x+3)/(x−9) = √x+3 (x≠9 da)"
    },
    {
     "text": "Limit: √9+3 = 6"
    }
   ],
   "result": "Javob: 6"
  },
  "narr": [
   "Bu misolda maxrajning konjugatiga ko'paytirish usulini qo'llaymiz.",
   "Bu usul ildizli ifodalarni soddalashtirishga yordam beradi.",
   "Natija 6 ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 98 — Noaniqlik 0/0",
   "problem": "lim h→0 (1/(a+h)−1/a)/h, bu yerda a — nol bo'lmagan haqiqiy doimiy.",
   "steps": [
    {
     "text": "Numeratorni bir xil maxrajga keltiramiz."
    },
    {
     "text": "1/(a+h)−1/a = [a−(a+h)]/[a(a+h)] = −h/[a(a+h)]"
    },
    {
     "text": "−h/[a(a+h)]/h = −1/[a(a+h)] (h≠0 da)"
    },
    {
     "text": "Limit: −1/a² (1/x ning hosilasi x=a da)"
    }
   ],
   "result": "Javob: −1/a²"
  },
  "narr": [
   "Bu misolda bir xil maxrajga keltirish usulini qo'llaymiz.",
   "Keyin ifodani soddalashtiramiz.",
   "Natija −1/a² ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1
  ]
 },
 {
  "type": "example",
  "data": {
   "heading": "Mashq 99 — Noaniqlik 0/0",
   "problem": "lim θ→π sinθ/tanθ",
   "steps": [
    {
     "text": "θ ≠ π yaqinida π da: sinθ/tanθ = sinθ·cosθ/sinθ"
    },
    {
     "text": "sinθ lar qisqaradi: cosθ (θ≠π da)"
    },
    {
     "text": "Limit: cosπ = -1"
    }
   ],
   "result": "Javob: -1"
  },
  "narr": [
   "Bu misolda trigonometrik ifodalarni soddalashtiramiz.",
   "Sinθ/tanθ ni sinθ·cosθ/sinθ deb yozamiz.",
   "Sinθ lar qisqarib, cosθ qoladi.",
   "Natija cosπ = -1 ga teng bo'ladi."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 }
