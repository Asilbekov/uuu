 {
  "type": "example",
  "data": {
   "heading": "Misol — Doira maydoni hisoblash",
   "problem": "R = 8,5[in]/12[in/ft]; A = πR²",
   "steps": [
    {
     "text": "Radiusni futga o'tkazamiz: R = 8,5 in / 12 in/ft = 0,7083 ft"
    },
    {
     "text": "Maydoni hisoblaymiz: A = π × (0,7083 ft)² = 1,576 ft²"
    },
    {
     "text": "Ma'noli raqamlar qoidasiga ko'ra, 2 ta ma'noli raqam bilan: A = 1,6 ft²"
    }
   ],
   "result": "A = 1,6 ft² (2 ta ma'noli raqam bilan)"
  },
  "narr": [
   "Doira maydonini hisoblash misoli orqali ma'noli raqamlar qoidasini qo'llaymiz.",
   "Birinchidan, radiusni futga o'tkazamiz.",
   "Keyin maydonini hisoblaymiz.",
   "Natijani ma'noli raqamlar qoidasiga ko'ra yaxlitlaymiz."
  ],
  "narr_item": [
   -1,
   0,
   1,
   2
  ]
 },
