generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  // Profile photo: `tg:<file_id>` (stored in the Telegram channel) or a small
  // data: URL fallback. Served by GET /api/users/[id]/avatar.
  image     String?
  // Test-taking background: key of a client-side preset list (TEST_BG_PRESETS).
  // null/'' = the standard app background. Edited on the profile page.
  bgStyle   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests     Test[]
  attempts  TestAttempt[]
  chatMessages ChatMessage[]
  // Tests the user saved to their personal library via the bookmark button
  bookmarks Bookmark[]
  // Tag-based interests picked during onboarding — seeds the For You feed
  interests String[] @default([])
  affinities TagAffinity[]
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, testId])
  @@index([userId])
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  topic       String   @default("Chemistry")
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  questions   Question[]
  attempts    TestAttempt[]
  attachments Attachment[]
  chatMessages ChatMessage[]
  isPublic    Boolean  @default(true)
  randomizeQuestions Boolean @default(false)
  randomizeOptions   Boolean @default(false)
  tags        String[] @default([])
  bookmarkedBy Bookmark[]
  coverImage  String?  // Base64 data URL for AI-generated cover image
  coverIcon   String?  // emoji picked in the editor from the science icon pack
  coverColor  String?  // hex color picked in the editor (card/cover background)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic, createdAt, id])
  @@index([creatorId, createdAt])
}

// Global tag dictionary: every tag used on a test lands here so it can be
// suggested via autocomplete next time someone types a similar tag
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Per-test group chat: every signed-in user can talk to everyone else
// taking the same test. Polled client-side (serverless-safe).
model ChatMessage {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  text      String
  createdAt DateTime @default(now())

  @@index([testId, createdAt])
}

// Files attached to a test (audio/video/PDF/link). Small uploaded files are
// stored inline as data: URLs; larger course media is referenced by external URL.
model Attachment {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  title       String
  type        String   @default("link") // "audio" | "video" | "pdf" | "image" | "link"
  url         String   // external URL or data: URL (small uploads)
  size        Int?     // bytes, when known
  // Telegram channel bookkeeping: the channel post that carries this file.
  // Needed to DELETE the file from the channel when it is removed from the test.
  tgMessageId Int?
  orderNum    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Question {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  text      String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  optionE   String?
  correctAnswer String @default("A")
  explanation   String?
  // Interface-language translations: { ru: { text, options: {A..E}, explanation }, uz: {...} }
  translations  Json?
  imageNumber   Int?
  // Question photo (shown above the answers): stored in the owner's Telegram
  // channel as `tg:<file_id>` (bytes never touch our DB) or inline `data:` URL
  // when the bot is not connected. imageMsgId keeps the channel post id so the
  // photo can be deleted from the channel when it is removed/replaced.
  imageUrl      String?
  imageMsgId    Int?
  // Per-option photos: { "A": { "u": "tg:<file_id>", "m": 12345 }, "C": {...} }.
  // "u" = url (tg:/data:/https:), "m" = channel post id for cleanup.
  optionImages  Json?
  orderNum      Int    @default(0)
  answers   AttemptAnswer[]
}

model TestAttempt {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0)
  totalQuestions Int  @default(0)
  completed Boolean  @default(false)
  answers   AttemptAnswer[]
  startedAt DateTime @default(now())
  completedAt DateTime?

  @@index([testId, startedAt])
  @@index([userId, startedAt])
}

// TikTok-style interest profile: every meaningful action on a test
// (open, start, complete) adds weight to its tags. Read-time half-life decay
// keeps the profile fresh. Powers the personalized "For You" feed.
model TagAffinity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String
  score     Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, tag])
  @@index([userId, score])
}

model AttemptAnswer {
  id        String   @id @default(cuid())
  attemptId String
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer String
  isCorrect Boolean
}
